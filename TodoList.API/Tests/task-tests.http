# ====================================================================================
# ENVIRONMENT CONFIGURATION
# ====================================================================================
@baseUrl = http://localhost:5124/api/Tasks
@authUrl = http://localhost:5124/api/Auth

### 0. PREVIOUS LOGIN (To obtain a valid Token)
# Run this request to authenticate. Copy the accessToken from the response
# and paste it below in the @authToken variable without quotes.
# ------------------------------------------------------------------------------------
POST {{authUrl}}/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Password123!"
}

### TOKEN CONFIGURATION (Paste your token below)
@authToken = eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlNGFhMjc1Ny1kMjMxLTQ2NzYtYjMwNC01MDUxYzYxODY1YzMiLCJlbWFpbCI6ImRldmVsb3BlcjIwMjZAZXhhbXBsZS5jb20iLCJ1bmlxdWVfbmFtZSI6ImRldmVsb3BlcjIwMjZAZXhhbXBsZS5jb20iLCJleHAiOjE3NzkyNzAwNzcsImlzcyI6IlRvZG9MaXN0QXBwIiwiYXVkIjoiVG9kb0xpc3RBcHAifQ.igdgqknm57_nLA6QIrcnWIfk6DPz-Sjl6Qbs5Ev1zhh_AoCG5s8CoSwuH9mMdhejgjMUPA6RGsxUOQAflQQ7kjAn71FOIJEicArzMycY7B6eRYfSJujpi2fXU6wkJ1mKWTq5mI-13vfljJtkGq2-zyS-dSJrq5i_WEXPKjhzr6hucKhE2ib8hWjjYDYqGakNc-OpFlXYh6hT-QSTwiPSH6422Ozs8agmK9DyRgNkmS7z6FGFkj8jzz_DN2kXaCgbvjrAi30FaqlFeqrvG0tevj0PrvwTypNZubA_8IMgFopWc5O_icOF-LO3-AiacKDT9_Zx4TL7G0JPS3dm8Rl5KA

# Change this GUID to the real ID returned by Test 1 (Create) or Test 2 (List)
@existingTaskId = fb360ee2-75fe-42c8-bc7a-695ccf6a47ad


# ====================================================================================
# 1. CREATE AND READ OPERATIONS (POST / GET)
# ====================================================================================

### Test 1: Create a new task (Must return 201 Created)
# Run this test first to generate a real task in your database and get its ID.
POST {{baseUrl}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Initial Task Title",
  "description": "This is the original description of the task.",
  "dueDate": "2026-12-25T12:00:00Z",
  "status": 1
}


### Test 2: List all tasks for the user (Must return 200 OK)
# Used to verify the previous task was listed correctly along with its ID.
GET {{baseUrl}}
Authorization: Bearer {{authToken}}


# ====================================================================================
# 2. SUCCESS AND AUTHORIZATION EDITING CASES (PUT)
# ====================================================================================

### Test 3: Successful Task Update (Must return 204 No Content)
PUT {{baseUrl}}/fb360ee2-75fe-42c8-bc7a-695ccf6a47ad
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Updated Task Title",
  "description": "Updated task description",
  "dueDate": "2026-12-31T23:59:59Z",
  "status": 2
}


### Test 4: Permission or Non-existence Error (Must return 404 Not Found)
# Tries to edit a task using a random GUID that doesn't exist or belongs to another user.
PUT {{baseUrl}}/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Hack Attack",
  "description": "Trying to modify a resource outside authorization boundaries.",
  "dueDate": "2026-12-31T23:59:59Z",
  "status": 3
}


### Test 5: Authentication Error Due to Missing Token (Must return 401 Unauthorized)
PUT {{baseUrl}}/{{existingTaskId}}
Content-Type: application/json

{
  "title": "Anonymous Update Attempt",
  "description": "This should be blocked immediately by UseAuthentication.",
  "dueDate": "2026-12-31T23:59:59Z",
  "status": 1
}


# ====================================================================================
# 3. VALIDATION TESTS (FluentValidation - Must return 400 Bad Request)
# ====================================================================================

### Test 6: Empty Title Validation
PUT {{baseUrl}}/{{existingTaskId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "",
  "description": "Fails because Title cannot be empty.",
  "dueDate": "2026-12-31T23:59:59Z",
  "status": 1
}


### Test 7: Invalid Status Range Validation (Status outside Enum bounds)
# The TaskStatus enum goes from 1 (Pending) to 5 (Canceled). We send a 6.
PUT {{baseUrl}}/{{existingTaskId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Testing Enum Status",
  "description": "Fails because 6 is out of the allowed 1-5 range context.",
  "dueDate": "2026-12-31T23:59:59Z",
  "status": 6
}


### Test 8: Past Due Date Validation
# Sends a date that has already passed to trigger the future date validator rule.
PUT {{baseUrl}}/{{existingTaskId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Expired Due Date Test",
  "description": "Fails because the target completion criteria is scheduled in the past.",
  "dueDate": "2020-01-01T00:00:00Z",
  "status": 1
}

# ====================================================================================
# 4. DELETE OPERATIONS
# ====================================================================================

### Test 9: Delete an existing task successfully (Must return 204 No Content)
# Replace this GUID with one of your task IDs (e.g.: 406a0b36-c145-4b33-9527-70394cf6bc7a)
DELETE {{baseUrl}}/{{existingTaskId}}
Authorization: Bearer {{authToken}}


### Test 10: Attempt to delete the same task again (Must return 404 Not Found)
# Having been deleted in the previous step, the server must respond that it no longer exists.
DELETE {{baseUrl}}/{{existingTaskId}}
Authorization: Bearer {{authToken}}