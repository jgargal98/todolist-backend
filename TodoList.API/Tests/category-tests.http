# TodoList API - Categories Endpoints Test Suite
# This file is compatible with Visual Studio (native extension) and VS Code (REST Client).

@baseUrl = http://localhost:5124/api

### =================================================================
### 1. AUTHENTICATION (Get JWT Token)
### =================================================================
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "developer2026@example.com",
  "password": "SecurePassword123!"
}

### DYNAMIC VARIABLES EXTRACTED FROM LOGIN
@authToken = {{login.response.body.accessToken}}
###


# 1. Get all categories (Initial state)
GET {{baseUrl}}/categories
Authorization: Bearer {{authToken}}
Accept: application/json

###

# 2. Create a valid category (Success - 201 Created)
# @name createCategory
POST {{baseUrl}}/categories
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Coñetes"
}

###
# 3. Capture dynamic ID from previous response
@createdCategoryId = {{createCategory.response.body.$.id}}

# (Manual alternative if your client doesn't support dynamic variables)
# @createdCategoryId = e1566a7b-3ef8-49db-8d14-386f6f1c4e7d

###

# 4. Try to create an empty category (Failure - 400 Bad Request from FluentValidation)
POST {{baseUrl}}/categories
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": ""
}

###

# 5. Try to create category with name exceeding max length (Failure - 400 Bad Request)
POST {{baseUrl}}/categories
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "This is an incredibly long category name designed to intentionally break the maximum length rule we set in the validator."
}

###

# 6. Update the newly created category (Success - 204 No Content)
PUT {{baseUrl}}/categories/{{createdCategoryId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Urgent Work"
}

###

# 7. Try to update a non-existent category (Failure - 404 Not Found security guard)
PUT {{baseUrl}}/categories/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Ghost Category"
}

###

# 8. Get all categories to verify the name was updated
GET {{baseUrl}}/categories
Authorization: Bearer {{authToken}}
Accept: application/json

###

# 9. Delete the category (Success - 204 No Content)
DELETE {{baseUrl}}/categories/{{createdCategoryId}}
Authorization: Bearer {{authToken}}

###

# 10. Try to delete the same category again (Failure - 404 Not Found)
DELETE {{baseUrl}}/categories/{{createdCategoryId}}
Authorization: Bearer {{authToken}}